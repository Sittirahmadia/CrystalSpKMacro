{
  "name": "crystalspk-macro",
  "version": "1.1.1",
  "description": "CrystalSpKMacro by noqwd",
  "main": "electron/main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win --x64",
    "build:portable": "electron-builder --win portable --x64",
    "build:installer": "electron-builder --win nsis --x64"
  },
  "dependencies": {
    "@hurdlegroup/robotjs": "^0.12.3",
    "electron-store": "^8.2.0",
    "electron-updater": "^6.8.3",
    "keysender": "^2.4.0",
    "node-machine-id": "^1.1.12"
  },
  "devDependencies": {
    "electron": "^29.0.0",
    "electron-builder": "^24.9.1"
  },
  "build": {
    "appId": "com.noqwd.crystalspkmacro",
    "productName": "CrystalSpKMacro",
    "copyright": "credit by noqwd",
    "directories": {
      "output": "dist"
    },
    "files": [
      "electron/**/*",
      "macros/**/*",
      "renderer/**/*",
      "assets/**/*",
      "native/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "macros/ahk",
        "to": "ahk",
        "filter": ["**/*.ahk"]
      }
    ],
    "win": {
      "icon": "assets/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        },
        {
          "target": "portable",
          "arch": ["x64"]
        }
      ],
      "requestedExecutionLevel": "requireAdministrator"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "assets/icon.ico",
      "installerHeaderIcon": "assets/icon.ico",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "CrystalSpKMacro"
    },
    "portable": {
      "artifactName": "CrystalSpKMacro-portable.exe"
    },
    "asar": true,
    "asarUnpack": [
      "native/**/*.node",
      "node_modules/@hurdlegroup/robotjs/**",
      "node_modules/keysender/**",
      "node_modules/node-machine-id/**"
    ]
  }
}
